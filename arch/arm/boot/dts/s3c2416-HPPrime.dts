/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "s3c2416.dtsi"

/ {
	model = "HPPrime";
	compatible = "samsung,smdk2416", "samsung,s3c2416";

	memory@30000000 {
		device_type = "memory";
		reg =  <0x30000000 0x2000000>;
	};

	xti: clock-0 {
		compatible = "fixed-clock";
		clock-frequency = <12000000>;
		clock-output-names = "xti";
		#clock-cells = <0>;
	};
	
    hsudc: hsudc@49800000 {
        compatible = "samsung,s3c2416-hsudc";
        reg = <0x49800000 0x200>;
        interrupt-parent = <&intc>; /* Ensure this points to your s3c24xx-irq node */
        interrupts = <0 0 25 1>;    /* <Ctrl_ID Parent_IRQ HWIRQ_Index Trigger> */
		pinctrl-names = "default";
        pinctrl-0 = <&hsudc_pullup>; 
    };
    matrix_keypad: matrix-keypad {
        compatible = "gpio-matrix-keypad";

        /* GPIO Configuration */

        row-gpios = <&gpg 0 GPIO_ACTIVE_HIGH>,
                    <&gpg 1 GPIO_ACTIVE_HIGH>,
                    <&gpg 2 GPIO_ACTIVE_HIGH>,
                    <&gpg 3 GPIO_ACTIVE_HIGH>,
                    <&gpg 4 GPIO_ACTIVE_HIGH>,
                    <&gpg 5 GPIO_ACTIVE_HIGH>,
                    <&gpg 6 GPIO_ACTIVE_HIGH>,
                    <&gpg 7 GPIO_ACTIVE_HIGH>;

        col-gpios = <&gpd 0 GPIO_ACTIVE_HIGH>,
                    <&gpd 1 GPIO_ACTIVE_HIGH>,
                    <&gpd 2 GPIO_ACTIVE_HIGH>,
                    <&gpd 3 GPIO_ACTIVE_HIGH>,
                    <&gpd 4 GPIO_ACTIVE_HIGH>,
                    <&gpd 5 GPIO_ACTIVE_HIGH>,
                    <&gpd 6 GPIO_ACTIVE_HIGH>,
                    <&gpd 7 GPIO_ACTIVE_HIGH>;
                    
        /* Timing Configuration */
        debounce-delay-ms = <10>;
        col-scan-delay-us = <100>;

        /* Feature Flags */
        wakeup-source; /* This boolean property enables wakeup */
       
        /* Fn Key Configuration (using our new binding) */
        linux,fn-key-position = <0 0>; /* Fn key is at ROW=0, COL=0 */

        /*
         * Keymaps
         * Format is: <scan_code linux_key_code>
         * scan_code = (row << 3) | column
         */
        linux,keymap = <
            /* Normal Layer */
            MATRIX_KEY(7, 0, KEY_ENTER)
            MATRIX_KEY(7, 1, KEY_RIGHT)
            MATRIX_KEY(6, 0, KEY_O) MATRIX_KEY(6, 1, KEY_R) MATRIX_KEY(6, 2, KEY_Q) MATRIX_KEY(6, 3, KEY_W)
            MATRIX_KEY(6, 4, KEY_V) MATRIX_KEY(6, 5, KEY_U) MATRIX_KEY(6, 6, KEY_SLASH) MATRIX_KEY(6, 7, KEY_Z)
            MATRIX_KEY(5, 0, KEY_S) MATRIX_KEY(5, 1, KEY_BACKSLASH)
            MATRIX_KEY(5, 2, KEY_MENU) MATRIX_KEY(5, 3, KEY_CAPSLOCK)
            MATRIX_KEY(5, 4, KEY_UP) MATRIX_KEY(5, 5, KEY_Y) MATRIX_KEY(5, 6, KEY_DOT) MATRIX_KEY(5, 7, KEY_PAUSE)
            MATRIX_KEY(4, 0, KEY_LEFTMETA) MATRIX_KEY(4, 1, KEY_LEFTALT) MATRIX_KEY(4, 2, KEY_TAB) MATRIX_KEY(4, 3, KEY_HOME)
            MATRIX_KEY(4, 4, KEY_GRAVE) MATRIX_KEY(4, 5, KEY_DOWN) MATRIX_KEY(4, 6, KEY_ESC) MATRIX_KEY(4, 7, KEY_N)
            MATRIX_KEY(3, 0, KEY_M) MATRIX_KEY(3, 1, KEY_L) MATRIX_KEY(3, 2, KEY_K) MATRIX_KEY(3, 3, KEY_J)
            MATRIX_KEY(3, 4, KEY_I) MATRIX_KEY(3, 5, KEY_H) MATRIX_KEY(3, 6, KEY_LEFTSHIFT) MATRIX_KEY(3, 7, KEY_F)
            MATRIX_KEY(2, 0, KEY_BACKSPACE) MATRIX_KEY(2, 1, KEY_D) MATRIX_KEY(2, 2, KEY_C) MATRIX_KEY(2, 3, KEY_LEFTCTRL)
            MATRIX_KEY(2, 4, KEY_E) MATRIX_KEY(2, 5, KEY_A) MATRIX_KEY(2, 6, KEY_G) MATRIX_KEY(2, 7, KEY_B)
            MATRIX_KEY(1, 0, KEY_P) MATRIX_KEY(1, 1, KEY_COMMA) MATRIX_KEY(1, 2, KEY_T) MATRIX_KEY(1, 3, KEY_X)
            MATRIX_KEY(1, 4, KEY_MINUS) MATRIX_KEY(1, 5, KEY_EQUAL) MATRIX_KEY(1, 6, KEY_SPACE) MATRIX_KEY(1, 7, KEY_LEFT)
        >;

        linux,fn-keymap = <
            /* Fn Layer */
            MATRIX_KEY(7, 0, KEY_ENTER)
            MATRIX_KEY(7, 1, KEY_END)
            MATRIX_KEY(6, 1, KEY_8) MATRIX_KEY(6, 2, KEY_7) MATRIX_KEY(6, 3, KEY_6)
            MATRIX_KEY(6, 4, KEY_5) MATRIX_KEY(6, 5, KEY_4) MATRIX_KEY(6, 6, KEY_3) MATRIX_KEY(6, 7, KEY_2)
            MATRIX_KEY(5, 0, KEY_9) MATRIX_KEY(5, 1, KEY_BACKSLASH)
            MATRIX_KEY(5, 2, KEY_MENU) MATRIX_KEY(5, 3, KEY_CAPSLOCK)
            MATRIX_KEY(5, 4, KEY_PAGEUP) MATRIX_KEY(5, 5, KEY_1) MATRIX_KEY(5, 6, KEY_DOT) MATRIX_KEY(5, 7, KEY_PAUSE)
            MATRIX_KEY(4, 0, KEY_RIGHTMETA) MATRIX_KEY(4, 1, KEY_RIGHTALT) MATRIX_KEY(4, 2, KEY_TAB) MATRIX_KEY(4, 3, KEY_INSERT)
            MATRIX_KEY(4, 4, KEY_GRAVE) MATRIX_KEY(4, 5, KEY_PAGEDOWN) MATRIX_KEY(4, 6, KEY_ESC) MATRIX_KEY(4, 7, KEY_APOSTROPHE)
            MATRIX_KEY(3, 1, KEY_F12) MATRIX_KEY(3, 2, KEY_F11) MATRIX_KEY(3, 3, KEY_F10) MATRIX_KEY(3, 4, KEY_F9)
            MATRIX_KEY(3, 5, KEY_F8) MATRIX_KEY(3, 6, KEY_RIGHTSHIFT) MATRIX_KEY(3, 7, KEY_F6)
            MATRIX_KEY(2, 0, KEY_DELETE) MATRIX_KEY(2, 1, KEY_F4) MATRIX_KEY(2, 2, KEY_F3) MATRIX_KEY(2, 3, KEY_RIGHTCTRL)
            MATRIX_KEY(2, 4, KEY_F5) MATRIX_KEY(2, 5, KEY_F1) MATRIX_KEY(2, 6, KEY_F7) MATRIX_KEY(2, 7, KEY_F2)
            MATRIX_KEY(1, 1, KEY_0) MATRIX_KEY(1, 2, KEY_LEFTBRACE) MATRIX_KEY(1, 3, KEY_RIGHTBRACE)
            MATRIX_KEY(1, 4, KEY_MINUS) MATRIX_KEY(1, 5, KEY_SEMICOLON) MATRIX_KEY(1, 6, KEY_SPACE) MATRIX_KEY(1, 7, KEY_HOME)
        >;
    };
	
	
};

&uart_0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_data>, <&uart0_fctl>;
    clock-names = "uart", "clk_uart_baud0";
	clocks = <&clocks PCLK_UART0>, <&clocks PCLK_UART0>;
};
&intc {
	status="okay";
};

&rtc {
	status = "okay";
};


&watchdog {
	status = "okay";
};
&i2c{
	status = "okay";
    pinctrl-names = "default";
	pinctrl-0 = <&i2c0_bus>;
        novatek_ts@1 {
        compatible = "novatek,nt11002";
        reg = <0x01>; /* 确保地址对 */
        
        irq-gpios =  <&gpf 2 GPIO_ACTIVE_HIGH>;   /* 0 = GPIO_ACTIVE_HIGH (物理电平), 驱动里配了触发沿，这里不重要 */
        reset-gpios = <&gpf 0 GPIO_ACTIVE_LOW>; /* 1 = GPIO_ACTIVE_LOW (逻辑1代表低电平) */

        /* 分辨率 */
        touchscreen-size-x = <0x1C0>;
        touchscreen-size-y = <0x140>;
    };
	
};
&pinctrl_0 {
    hsudc_pullup: hsudc-pullup {
        samsung,pins = "gph-14";
        samsung,pin-function = <1>; /* Function 1 = Output */
        samsung,pin-pud = <2>;      /* Pull-Up (S3C2416: 0=None, 1=Down, 2=Up) */
        samsung,pin-val = <1>;      /* Initial Value = High (拉高启用 USB) */
    };
    };
&gpg {
status = "okay";
};
&gpd {
status = "okay";
};
